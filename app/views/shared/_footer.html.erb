<footer class="relative mt-24 bg-sand-100 text-sand-800">
  <div class="absolute -top-10 left-10 text-succulent-400/70">
    <%= render "shared/succulent", variant: :sprig, class: "h-20 w-20" %>
  </div>
  <div class="absolute -top-12 right-12 text-succulent-300/80">
    <%= render "shared/succulent", variant: :prickly, class: "h-24 w-24" %>
  </div>

  <div class="section py-16 grid gap-10 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-3">
        <span class="text-succulent-500"><%= render "shared/succulent", variant: :rosette, class: "h-8 w-8" %></span>
        <span class="font-display text-xl text-sand-900">Sultana Dining</span>
      </div>
      <p class="mt-4 text-sm leading-relaxed max-w-xs">
        A private chef &amp; catering kitchen — handmade casseroles, baked goods, and seasonal table spreads.
      </p>
    </div>

    <div>
      <h4 class="eyebrow">Visit</h4>
      <p class="mt-3 text-sm">By appointment · Pickup &amp; delivery</p>
      <p class="mt-1 text-sm">Mon — Sat · 9am to 6pm</p>
    </div>

    <div id="contact">
      <h4 class="eyebrow">Get in touch</h4>
      <p class="mt-3 text-sm">hello@sultanadining.com</p>
      <p class="mt-1 text-sm">+1 (555) 010-2024</p>
    </div>
  </div>

  <div class="border-t border-sand-200">
    <div class="section py-5 text-xs flex flex-col sm:flex-row gap-2 justify-between text-sand-700">
      <span>© <%= Date.current.year %> Sultana Dining. Made with care.</span>
      <span>Handmade in small batches.</span>
    </div>
  </div>
</footer>
