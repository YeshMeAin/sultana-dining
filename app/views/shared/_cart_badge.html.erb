<div id="cart_badge"
     class="<%= count > 0 ? '' : 'hidden' %> fixed bottom-6 end-6 z-50">
  <button onclick="window.dispatchEvent(new CustomEvent('cart:open'))"
          class="relative flex items-center gap-2 rounded-full bg-clay-600 px-5 py-3
                 text-sand-50 shadow-lg hover:bg-clay-700 transition-colors"
          aria-label="<%= t('cart.open') %>">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
         viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round"
            d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993
               1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125
               0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513
               7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625
               10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75
               0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
    </svg>
    <span class="text-sm font-bold"><%= count %></span>
  </button>
</div>
