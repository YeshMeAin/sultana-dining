<%#
  Succulent SVG accent.
  Variants:
    :rosette  — top-down echeveria-style rosette (good for corners & dividers)
    :sprig    — small succulent sprig (good as a bullet / divider mark)
    :prickly  — prickly pear silhouette (good for section corners)
  Pass `class:` to control size/color (uses currentColor for fills).
%>
<% variant ||= :rosette %>
<% css_class = local_assigns[:class] || "h-10 w-10 text-succulent-400" %>

<% case variant %>
<% when :rosette %>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="currentColor" aria-hidden="true" class="<%= css_class %>">
    <g opacity="0.95">
      <ellipse cx="32" cy="32" rx="6" ry="10" />
      <ellipse cx="32" cy="32" rx="10" ry="6" />
      <ellipse cx="32" cy="32" rx="9" ry="9" transform="rotate(45 32 32)" opacity="0.85" />
      <ellipse cx="32" cy="32" rx="9" ry="9" transform="rotate(-45 32 32)" opacity="0.85" />
      <ellipse cx="32" cy="32" rx="12" ry="5" transform="rotate(22 32 32)" opacity="0.7" />
      <ellipse cx="32" cy="32" rx="12" ry="5" transform="rotate(-22 32 32)" opacity="0.7" />
      <ellipse cx="32" cy="32" rx="14" ry="4" transform="rotate(67 32 32)" opacity="0.55" />
      <ellipse cx="32" cy="32" rx="14" ry="4" transform="rotate(-67 32 32)" opacity="0.55" />
      <circle cx="32" cy="32" r="2.5" class="text-succulent-700" fill="currentColor" />
    </g>
  </svg>
<% when :sprig %>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="currentColor" aria-hidden="true" class="<%= css_class %>">
    <path d="M32 58 C 30 44, 30 30, 32 12" stroke="currentColor" stroke-width="1.5" fill="none" />
    <ellipse cx="22" cy="40" rx="6" ry="11" transform="rotate(-30 22 40)" />
    <ellipse cx="42" cy="36" rx="6" ry="11" transform="rotate(30 42 36)" opacity="0.85" />
    <ellipse cx="24" cy="26" rx="5" ry="9" transform="rotate(-20 24 26)" opacity="0.8" />
    <ellipse cx="40" cy="22" rx="5" ry="9" transform="rotate(20 40 22)" opacity="0.7" />
    <ellipse cx="32" cy="14" rx="4" ry="7" opacity="0.7" />
  </svg>
<% when :prickly %>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="currentColor" aria-hidden="true" class="<%= css_class %>">
    <ellipse cx="32" cy="42" rx="11" ry="18" />
    <ellipse cx="20" cy="34" rx="7" ry="11" transform="rotate(-25 20 34)" opacity="0.9" />
    <ellipse cx="44" cy="30" rx="7" ry="12" transform="rotate(20 44 30)" opacity="0.9" />
    <ellipse cx="14" cy="22" rx="5" ry="8" transform="rotate(-35 14 22)" opacity="0.75" />
    <ellipse cx="50" cy="20" rx="5" ry="9" transform="rotate(25 50 20)" opacity="0.75" />
  </svg>
<% end %>
