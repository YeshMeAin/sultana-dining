<header class="absolute inset-x-0 top-0 z-30">
  <div class="section flex items-center justify-between py-6">
    <%= link_to root_path, class: "flex items-center gap-3 group" do %>
      <span class="text-succulent-500 group-hover:text-succulent-600 transition-colors">
        <%= render "shared/succulent", variant: :rosette, class: "h-9 w-9" %>
      </span>
      <span class="font-display text-2xl tracking-tight text-sand-900">
        Sultana <span class="text-clay-600">Dining</span>
      </span>
    <% end %>

    <nav class="hidden md:flex items-center gap-1 text-sm">
      <%= link_to t("nav.home"),     root_path,   class: "btn-ghost" %>
      <%= link_to t("nav.shop"),     shop_path,   class: "btn-ghost" %>
      <%= link_to t("nav.catering"), "#catering", class: "btn-ghost" %>
      <%= link_to t("nav.about"),    "#about",    class: "btn-ghost" %>
      <%= link_to t("nav.contact"),  "#contact",  class: "btn-ghost" %>
    </nav>

    <div class="flex items-center gap-3">
      <% other_locale = I18n.locale == :en ? :he : :en %>
      <%= link_to t("nav.language"), root_path(locale: other_locale), class: "btn-ghost text-sm font-medium" %>
      <%= render "shared/cart_badge", count: current_cart.total_count %>
      <%= link_to t("nav.order_now"), shop_path, class: "btn-primary hidden sm:inline-flex" %>
    </div>
  </div>
</header>
