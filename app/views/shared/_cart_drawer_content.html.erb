<% if cart.empty? %>
  <div class="flex flex-col items-center justify-center flex-1 px-6 py-12 text-center">
    <svg class="h-16 w-16 text-sand-300 mb-4" fill="none" viewBox="0 0 24 24"
         stroke="currentColor" stroke-width="1">
      <path stroke-linecap="round" stroke-linejoin="round"
            d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993
               1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125
               0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513
               7.5h12.974c.576 0 1.059.435 1.119 1.007Z"/>
    </svg>
    <p class="text-sand-600"><%= t("cart.empty") %></p>
    <%= link_to t("cart.browse"), shop_path, class: "btn-primary mt-4" %>
  </div>
<% else %>
  <div class="divide-y divide-sand-200 flex-1">
    <% cart.line_items.each do |line| %>
      <%= render "shared/cart_line_item", line: line %>
    <% end %>
  </div>

  <div class="border-t border-sand-200 px-6 py-4 mt-auto">
    <div class="flex justify-between items-center mb-4">
      <span class="font-display text-lg text-sand-900"><%= t("cart.subtotal") %></span>
      <span class="font-display text-lg text-clay-600">
        &#8362;<%= number_with_precision(cart.subtotal, precision: 0) %>
      </span>
    </div>
    <button class="btn-primary w-full" disabled>
      <%= t("cart.checkout") %>
    </button>
  </div>
<% end %>
