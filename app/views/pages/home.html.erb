<% content_for :title, "Sultana Dining — Private Chef & Catering" %>

<%#
  Carousel slides — for now we use rich CSS gradient panels with a SVG label,
  so the page works before real photos are uploaded. Swap the inner of each
  data-carousel-target="slide" with <img> tags once images are ready.
%>
<% slides = [
  { title: "Sunday casseroles", subtitle: "Slow-baked, deeply seasoned, made for sharing.", from: "from-clay-200",      to: "to-clay-400" },
  { title: "From the oven",     subtitle: "Sourdoughs, tarts, and stone-fruit galettes.",    from: "from-sand-200",      to: "to-clay-300" },
  { title: "Garden plates",     subtitle: "Seasonal salads with herbs picked the same day.", from: "from-succulent-200", to: "to-succulent-400" },
  { title: "Private tables",    subtitle: "Catered dinners for ten to forty guests.",        from: "from-sand-300",      to: "to-sand-500" }
] %>

<%# ----------------------------------------------------------------- HERO -%>
<section class="relative overflow-hidden bg-sand-100">
  <%# Decorative succulents %>
  <div class="pointer-events-none absolute -top-10 -left-12 text-succulent-300/70">
    <%= render "shared/succulent", variant: :prickly, class: "h-56 w-56" %>
  </div>
  <div class="pointer-events-none absolute top-32 right-4 text-succulent-400/60 hidden sm:block">
    <%= render "shared/succulent", variant: :sprig, class: "h-40 w-40" %>
  </div>
  <div class="pointer-events-none absolute -bottom-16 right-1/3 text-succulent-300/50">
    <%= render "shared/succulent", variant: :rosette, class: "h-72 w-72" %>
  </div>

  <div class="section pt-40 pb-20 md:pt-48 md:pb-28 relative">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <span class="eyebrow">Private chef · Catering · Pickup</span>
        <h1 class="mt-4 text-4xl sm:text-5xl md:text-6xl text-sand-900 leading-[1.05]">
          A kitchen built for<br>
          <span class="text-clay-600">slow, generous</span> meals.
        </h1>
        <p class="mt-6 max-w-lg text-lg text-sand-800/90 leading-relaxed">
          Handmade casseroles, fresh-baked breads and pastries, and full catering
          for dinners that feel like they were always meant to happen at your table.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#shop" class="btn-primary">Browse the deli</a>
          <a href="#catering" class="btn-secondary">Plan a catering</a>
        </div>
      </div>

      <%# ----------------------------------------------------- CAROUSEL %>
      <div
        class="relative rounded-3xl overflow-hidden ring-1 ring-sand-300/70 shadow-xl shadow-sand-900/10 aspect-[5/4]"
        data-controller="carousel"
        data-carousel-interval-value="5000">

        <% slides.each_with_index do |slide, i| %>
          <div
            data-carousel-target="slide"
            class="absolute inset-0 transition-opacity duration-700 ease-in-out <%= i == 0 ? 'opacity-100' : 'opacity-0 pointer-events-none' %>">
            <div class="absolute inset-0 bg-gradient-to-br <%= slide[:from] %> <%= slide[:to] %>"></div>

            <%# Subtle texture: layered succulent silhouettes %>
            <div class="absolute -bottom-10 -right-8 text-sand-50/30">
              <%= render "shared/succulent", variant: :rosette, class: "h-72 w-72" %>
            </div>
            <div class="absolute top-8 left-8 text-sand-50/40">
              <%= render "shared/succulent", variant: :sprig, class: "h-24 w-24" %>
            </div>

            <%# Slide label %>
            <div class="absolute inset-x-0 bottom-0 p-8 bg-gradient-to-t from-sand-900/60 to-transparent">
              <h3 class="font-display text-3xl text-sand-50"><%= slide[:title] %></h3>
              <p class="mt-1 text-sand-100/90 text-sm max-w-sm"><%= slide[:subtitle] %></p>
            </div>
          </div>
        <% end %>

        <%# Controls %>
        <button type="button"
                data-action="click->carousel#prev"
                aria-label="Previous slide"
                class="absolute left-3 top-1/2 -translate-y-1/2 z-10 grid place-items-center h-10 w-10 rounded-full bg-sand-50/80 text-sand-900 hover:bg-sand-50 transition">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button"
                data-action="click->carousel#next"
                aria-label="Next slide"
                class="absolute right-3 top-1/2 -translate-y-1/2 z-10 grid place-items-center h-10 w-10 rounded-full bg-sand-50/80 text-sand-900 hover:bg-sand-50 transition">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M9 6l6 6-6 6"/></svg>
        </button>

        <%# Dots %>
        <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex items-center gap-2 z-10">
          <% slides.each_with_index do |_, i| %>
            <button type="button"
                    data-carousel-target="dot"
                    data-action="click->carousel#goTo"
                    data-index="<%= i %>"
                    aria-label="Slide <%= i + 1 %>"
                    class="h-2.5 rounded-full transition-all duration-300 <%= i == 0 ? 'bg-clay-500 w-8' : 'bg-sand-300 w-2.5' %>"></button>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ----------------------------------------------------------- SERVICES -%>
<section id="catering" class="section py-24">
  <div class="text-center max-w-2xl mx-auto">
    <span class="eyebrow">What we do</span>
    <h2 class="mt-3 text-3xl md:text-4xl text-sand-900">A small kitchen, a wide table.</h2>
    <p class="mt-4 text-sand-700">From single casseroles dropped off at your door to full-service catering for special evenings — all from one pair of hands.</p>
  </div>

  <div class="mt-14 grid gap-6 md:grid-cols-3">
    <% [
      { icon: :rosette,  title: "Private chef",  body: "In-home dinners with menus shaped around the season and your guests." },
      { icon: :sprig,    title: "Catering",      body: "Drop-off and full-service catering for gatherings of ten to forty." },
      { icon: :prickly,  title: "The deli",      body: "Ready-to-bake casseroles, breads, and pastries — order by Friday for the weekend." }
    ].each do |svc| %>
      <div class="card p-8 hover:ring-clay-300 transition">
        <span class="text-succulent-500">
          <%= render "shared/succulent", variant: svc[:icon], class: "h-12 w-12" %>
        </span>
        <h3 class="mt-5 font-display text-2xl text-sand-900"><%= svc[:title] %></h3>
        <p class="mt-2 text-sand-700 leading-relaxed"><%= svc[:body] %></p>
      </div>
    <% end %>
  </div>
</section>

<%# ------------------------------------------------------------- STORY -%>
<section id="about" class="bg-sand-100 border-y border-sand-200/60">
  <div class="section py-24 grid gap-12 md:grid-cols-5 items-center">
    <div class="md:col-span-2 relative">
      <div class="aspect-[4/5] rounded-3xl bg-gradient-to-br from-clay-300 to-sand-500 relative overflow-hidden ring-1 ring-sand-300/60">
        <div class="absolute -bottom-10 -right-10 text-sand-50/30">
          <%= render "shared/succulent", variant: :rosette, class: "h-72 w-72" %>
        </div>
        <div class="absolute top-6 left-6 text-sand-50/50">
          <%= render "shared/succulent", variant: :sprig, class: "h-20 w-20" %>
        </div>
      </div>
    </div>
    <div class="md:col-span-3">
      <span class="eyebrow">The story</span>
      <h2 class="mt-3 text-3xl md:text-4xl text-sand-900">Cooking the way it’s meant to be cooked.</h2>
      <p class="mt-5 text-sand-700 leading-relaxed">
        Sultana Dining is a one-kitchen operation rooted in slow techniques: long-rise breads,
        casseroles that simmer for an afternoon, sauces built from scratch. Everything is made
        in small batches, the way it would be in a family kitchen — just a little more of it,
        for the people you want to feed.
      </p>
      <p class="mt-4 text-sand-700 leading-relaxed">
        We source from a short list of local growers and bakeries, change the menu with the
        season, and never serve anything we wouldn’t set on our own table.
      </p>
    </div>
  </div>
</section>

<%# --------------------------------------------------------------- CTA -%>
<section id="shop" class="section py-24">
  <div class="relative overflow-hidden rounded-3xl bg-clay-600 text-sand-50 p-12 md:p-16">
    <div class="absolute -bottom-20 -right-16 text-sand-50/10">
      <%= render "shared/succulent", variant: :prickly, class: "h-96 w-96" %>
    </div>
    <div class="absolute top-8 right-8 text-sand-50/15">
      <%= render "shared/succulent", variant: :rosette, class: "h-32 w-32" %>
    </div>
    <div class="relative max-w-2xl">
      <span class="eyebrow text-clay-200">The deli is open</span>
      <h2 class="mt-3 text-3xl md:text-4xl">Order the weekend table.</h2>
      <p class="mt-4 text-sand-100/90 leading-relaxed">
        Casseroles, baked goods, salads, and sides — order by Friday, pick up Saturday morning. We’ll have it labeled with reheating instructions and a hand-written note.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#" class="btn bg-sand-50 text-clay-700 hover:bg-sand-100">Browse the deli</a>
        <a href="#contact" class="btn bg-transparent ring-1 ring-sand-50/40 text-sand-50 hover:bg-sand-50/10">Ask a question</a>
      </div>
    </div>
  </div>
</section>
