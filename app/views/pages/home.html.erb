<% content_for :title, t("site.title") %>

<% slide_keys = %w[sunday oven garden private] %>
<% slide_styles = [
  { from: "from-clay-200",      to: "to-clay-400" },
  { from: "from-sand-200",      to: "to-clay-300" },
  { from: "from-succulent-200", to: "to-succulent-400" },
  { from: "from-sand-300",      to: "to-sand-500" }
] %>

<%# ----------------------------------------------------------------- HERO -%>
<section class="relative overflow-hidden bg-sand-100">
  <%# Decorative succulents %>
  <div class="pointer-events-none absolute -top-10 -start-12 text-succulent-300/70">
    <%= render "shared/succulent", variant: :prickly, class: "h-56 w-56" %>
  </div>
  <div class="pointer-events-none absolute top-32 end-4 text-succulent-400/60 hidden sm:block">
    <%= render "shared/succulent", variant: :sprig, class: "h-40 w-40" %>
  </div>
  <div class="pointer-events-none absolute -bottom-16 end-1/3 text-succulent-300/50">
    <%= render "shared/succulent", variant: :rosette, class: "h-72 w-72" %>
  </div>

  <div class="section pt-40 pb-20 md:pt-48 md:pb-28 relative">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <span class="eyebrow"><%= t("hero.eyebrow") %></span>
        <h1 class="mt-4 text-4xl sm:text-5xl md:text-6xl text-sand-900 leading-[1.05]">
          <%= t("hero.heading_start") %><br>
          <span class="text-clay-600"><%= t("hero.heading_highlight") %></span> <%= t("hero.heading_end") %>
        </h1>
        <p class="mt-6 max-w-lg text-lg text-sand-800/90 leading-relaxed">
          <%= t("hero.description") %>
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#shop" class="btn-primary"><%= t("hero.browse_deli") %></a>
          <a href="#catering" class="btn-secondary"><%= t("hero.plan_catering") %></a>
        </div>
      </div>

      <%# ----------------------------------------------------- CAROUSEL %>
      <div
        class="relative rounded-3xl overflow-hidden ring-1 ring-sand-300/70 shadow-xl shadow-sand-900/10 aspect-[5/4]"
        data-controller="carousel"
        data-carousel-interval-value="5000">

        <% slide_keys.each_with_index do |key, i| %>
          <div
            data-carousel-target="slide"
            class="absolute inset-0 transition-opacity duration-700 ease-in-out <%= i == 0 ? 'opacity-100' : 'opacity-0 pointer-events-none' %>">
            <div class="absolute inset-0 bg-gradient-to-br <%= slide_styles[i][:from] %> <%= slide_styles[i][:to] %>"></div>

            <%# Subtle texture: layered succulent silhouettes %>
            <div class="absolute -bottom-10 -end-8 text-sand-50/30">
              <%= render "shared/succulent", variant: :rosette, class: "h-72 w-72" %>
            </div>
            <div class="absolute top-8 start-8 text-sand-50/40">
              <%= render "shared/succulent", variant: :sprig, class: "h-24 w-24" %>
            </div>

            <%# Slide label %>
            <div class="absolute inset-x-0 bottom-0 p-8 bg-gradient-to-t from-sand-900/60 to-transparent">
              <h3 class="font-display text-3xl text-sand-50"><%= t("slides.#{key}.title") %></h3>
              <p class="mt-1 text-sand-100/90 text-sm max-w-sm"><%= t("slides.#{key}.subtitle") %></p>
            </div>
          </div>
        <% end %>

        <%# Controls %>
        <button type="button"
                data-action="click->carousel#prev"
                aria-label="<%= t('hero.prev_slide') %>"
                class="absolute start-3 top-1/2 -translate-y-1/2 z-10 grid place-items-center h-10 w-10 rounded-full bg-sand-50/80 text-sand-900 hover:bg-sand-50 transition">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5 rtl-flip"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button"
                data-action="click->carousel#next"
                aria-label="<%= t('hero.next_slide') %>"
                class="absolute end-3 top-1/2 -translate-y-1/2 z-10 grid place-items-center h-10 w-10 rounded-full bg-sand-50/80 text-sand-900 hover:bg-sand-50 transition">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5 rtl-flip"><path d="M9 6l6 6-6 6"/></svg>
        </button>

        <%# Dots %>
        <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex items-center gap-2 z-10">
          <% slide_keys.each_with_index do |_, i| %>
            <button type="button"
                    data-carousel-target="dot"
                    data-action="click->carousel#goTo"
                    data-index="<%= i %>"
                    aria-label="<%= t('hero.slide_label', number: i + 1) %>"
                    class="h-2.5 rounded-full transition-all duration-300 <%= i == 0 ? 'bg-clay-500 w-8' : 'bg-sand-300 w-2.5' %>"></button>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ----------------------------------------------------------- SERVICES -%>
<section id="catering" class="section py-24">
  <div class="text-center max-w-2xl mx-auto">
    <span class="eyebrow"><%= t("services.eyebrow") %></span>
    <h2 class="mt-3 text-3xl md:text-4xl text-sand-900"><%= t("services.heading") %></h2>
    <p class="mt-4 text-sand-700"><%= t("services.description") %></p>
  </div>

  <div class="mt-14 grid gap-6 md:grid-cols-3">
    <% [
      { icon: :rosette,  key: "private_chef" },
      { icon: :sprig,    key: "catering" },
      { icon: :prickly,  key: "deli" }
    ].each do |svc| %>
      <div class="card p-8 hover:ring-clay-300 transition">
        <span class="text-succulent-500">
          <%= render "shared/succulent", variant: svc[:icon], class: "h-12 w-12" %>
        </span>
        <h3 class="mt-5 font-display text-2xl text-sand-900"><%= t("services.#{svc[:key]}.title") %></h3>
        <p class="mt-2 text-sand-700 leading-relaxed"><%= t("services.#{svc[:key]}.body") %></p>
      </div>
    <% end %>
  </div>
</section>

<%# ------------------------------------------------------------- STORY -%>
<section id="about" class="bg-sand-100 border-y border-sand-200/60">
  <div class="section py-24 grid gap-12 md:grid-cols-5 items-center">
    <div class="md:col-span-2 relative">
      <div class="aspect-[4/5] rounded-3xl bg-gradient-to-br from-clay-300 to-sand-500 relative overflow-hidden ring-1 ring-sand-300/60">
        <div class="absolute -bottom-10 -end-10 text-sand-50/30">
          <%= render "shared/succulent", variant: :rosette, class: "h-72 w-72" %>
        </div>
        <div class="absolute top-6 start-6 text-sand-50/50">
          <%= render "shared/succulent", variant: :sprig, class: "h-20 w-20" %>
        </div>
      </div>
    </div>
    <div class="md:col-span-3">
      <span class="eyebrow"><%= t("story.eyebrow") %></span>
      <h2 class="mt-3 text-3xl md:text-4xl text-sand-900"><%= t("story.heading") %></h2>
      <p class="mt-5 text-sand-700 leading-relaxed"><%= t("story.paragraph_1") %></p>
      <p class="mt-4 text-sand-700 leading-relaxed"><%= t("story.paragraph_2") %></p>
    </div>
  </div>
</section>

<%# --------------------------------------------------------------- CTA -%>
<section id="shop" class="section py-24">
  <div class="relative overflow-hidden rounded-3xl bg-clay-600 text-sand-50 p-12 md:p-16">
    <div class="absolute -bottom-20 -end-16 text-sand-50/10">
      <%= render "shared/succulent", variant: :prickly, class: "h-96 w-96" %>
    </div>
    <div class="absolute top-8 end-8 text-sand-50/15">
      <%= render "shared/succulent", variant: :rosette, class: "h-32 w-32" %>
    </div>
    <div class="relative max-w-2xl">
      <span class="eyebrow text-clay-200"><%= t("cta.eyebrow") %></span>
      <h2 class="mt-3 text-3xl md:text-4xl"><%= t("cta.heading") %></h2>
      <p class="mt-4 text-sand-100/90 leading-relaxed"><%= t("cta.description") %></p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#" class="btn bg-sand-50 text-clay-700 hover:bg-sand-100"><%= t("cta.browse_deli") %></a>
        <a href="#contact" class="btn bg-transparent ring-1 ring-sand-50/40 text-sand-50 hover:bg-sand-50/10"><%= t("cta.ask_question") %></a>
      </div>
    </div>
  </div>
</section>
