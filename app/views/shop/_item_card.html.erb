<% cart ||= current_cart %>
<% qty_in_cart = cart.items[item.id.to_s] || 0 %>
<div id="item_card_<%= item.id %>" class="card flex flex-col">
  <%# Image or placeholder %>
  <div class="aspect-[4/3] relative overflow-hidden">
    <% if item.image.attached? %>
      <%= image_tag item.image.variant(resize_to_fill: [600, 450]),
          class: "h-full w-full object-cover",
          alt: item.name,
          loading: "lazy" %>
    <% else %>
      <div class="h-full w-full bg-gradient-to-br from-sand-200 to-clay-200 flex items-center justify-center">
        <%= render "shared/succulent", variant: :rosette, class: "h-16 w-16 text-sand-400/60" %>
      </div>
    <% end %>

    <% unless item.available? %>
      <span class="absolute top-3 end-3 rounded-full bg-sand-800/70 px-3 py-1 text-xs font-medium text-sand-50">
        <%= t("shop.unavailable") %>
      </span>
    <% end %>

    <% if qty_in_cart > 0 %>
      <span class="absolute top-3 start-3 flex h-7 w-7 items-center justify-center
                    rounded-full bg-clay-500 text-xs font-bold text-sand-50 shadow-md">
        <%= qty_in_cart %>
      </span>
    <% end %>
  </div>

  <%# Card body %>
  <div class="flex flex-1 flex-col p-5">
    <span class="eyebrow"><%= item.category.name %></span>
    <h3 class="mt-1 font-display text-xl text-sand-900"><%= item.name %></h3>
    <p class="mt-2 flex-1 text-sm text-sand-700 leading-relaxed"><%= item.description %></p>
    <p class="mt-4 font-display text-lg text-clay-600">
      &#8362;<%= number_with_precision(item.price, precision: 0) %>
    </p>
    <% if item.available? %>
      <% if qty_in_cart > 0 %>
        <div class="mt-4 flex items-center justify-between gap-2">
          <%= button_to cart_item_path(item),
              method: :patch,
              params: { quantity: qty_in_cart - 1 },
              form: { data: { turbo_frame: "_top" } },
              class: "h-9 w-9 rounded-full border border-sand-300 grid place-items-center
                      text-sand-700 hover:bg-sand-100 transition-colors" do %>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" d="M5 12h14"/>
            </svg>
          <% end %>

          <span class="font-display text-lg text-sand-900"><%= qty_in_cart %></span>

          <%= button_to cart_item_path(item),
              method: :patch,
              params: { quantity: qty_in_cart + 1 },
              form: { data: { turbo_frame: "_top" } },
              class: "h-9 w-9 rounded-full border border-sand-300 grid place-items-center
                      text-sand-700 hover:bg-sand-100 transition-colors" do %>
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" d="M12 5v14m-7-7h14"/>
            </svg>
          <% end %>
        </div>
      <% else %>
        <%= button_to t("cart.add"), cart_items_path(item_id: item.id),
            method: :post, class: "btn-primary mt-4 w-full text-sm",
            form: { data: { turbo_frame: "_top" } } %>
      <% end %>
    <% end %>
  </div>
</div>
