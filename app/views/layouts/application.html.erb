<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= I18n.locale == :he ? 'rtl' : 'ltr' %>">
  <head>
    <title><%= content_for(:title) || t("site.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t('site.name') %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= content_for(:description) || t('site.description') %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen flex flex-col">
    <%= render "shared/navbar" %>

    <main class="flex-1">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
    <%= render "shared/cart_badge", count: current_cart.total_count %>
    <%= render "shared/cart_drawer" %>
  </body>
</html>
