<%= turbo_stream.replace "cart_badge" do %>
  <%= render "shared/cart_badge", count: current_cart.total_count %>
<% end %>
<%= turbo_stream.update "cart_drawer_content" do %>
  <%= render "shared/cart_drawer_content", cart: current_cart %>
<% end %>
<% if @item %>
  <%= turbo_stream.replace "item_card_#{@item.id}" do %>
    <%= render "shop/item_card", item: @item, cart: current_cart %>
  <% end %>
<% end %>
