{
  "name": "sultanas-kitchen",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "concurrently \"pnpm --filter web dev\" \"pnpm --filter agent dev\"",
    "build": "pnpm --filter db build && pnpm --filter web build",
    "db:push": "pnpm --filter db push",
    "db:studio": "pnpm --filter db studio",
    "db:generate": "pnpm --filter db generate"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
